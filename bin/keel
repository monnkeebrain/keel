#!/usr/bin/env python3
"""keel — mechanical core of the keel method. Stdlib only.

Subcommands: gate · pack · state · distill · render · adapt · boot
Thin wrappers in bin/ call this dispatcher. See METHOD.md §4.
"""
import argparse, datetime, json, re, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STORIES = ROOT / "data" / "stories.json"
EPICS_DIR = ROOT / "data" / "epics"
STATE = ROOT / "STATE.md"
DECISIONS = ROOT / "decisions.md"
LAWS_DIR = ROOT / "laws"
ARCHIVE = ROOT / "archive"
ADAPTERS = ROOT / "adapters"
STATUS_ORDER = ["review", "blocked", "in_progress", "ready", "backlog", "done", "abandoned"]
VAGUE = ["works well", "intuitive", "robust", "nice", "user-friendly",
         "better", "fast", "clean", "modern", "properly"]
NOW = lambda: datetime.datetime.now(datetime.timezone.utc)


def git(*args):
    try:
        return subprocess.run(["git", "-C", str(ROOT), *args],
                              capture_output=True, text=True, check=True).stdout.strip()
    except Exception:
        return "?"


def load_stories():
    if not STORIES.exists():
        sys.exit(f"keel: missing {STORIES}")
    return json.loads(STORIES.read_text(encoding="utf-8"))


def save_stories(arr):
    STORIES.write_text(json.dumps(arr, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def list_epic_paths():
    if not EPICS_DIR.exists():
        return []
    return sorted(EPICS_DIR.glob("*.json"))


def load_epic(eid):
    path = EPICS_DIR / f"{eid}.json"
    if not path.exists():
        sys.exit(f"keel: epic '{eid}' not found in {EPICS_DIR.relative_to(ROOT)}")
    try:
        obj = json.loads(path.read_text(encoding="utf-8"))
    except Exception as e:
        sys.exit(f"keel: epic '{eid}' unparseable: {e}")
    if not isinstance(obj, dict):
        sys.exit(f"keel: epic '{eid}' is not a JSON object")
    return obj, path


def save_epic(obj):
    EPICS_DIR.mkdir(parents=True, exist_ok=True)
    path = EPICS_DIR / f"{obj['id']}.json"
    path.write_text(json.dumps(obj, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return path


def wipe_epic_files():
    EPICS_DIR.mkdir(parents=True, exist_ok=True)
    for p in list_epic_paths():
        p.unlink()


def epic_listing(sid):
    """Return the epic object whose stories[] contains sid, or None."""
    for p in list_epic_paths():
        try:
            obj = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            continue
        if isinstance(obj, dict) and sid in (obj.get("stories") or []):
            return obj
    return None


def prefix_overlap(a, b):
    a, b = str(a).rstrip("/"), str(b).rstrip("/")
    if not a or not b:
        return False
    return a == b or a.startswith(b + "/") or b.startswith(a + "/")


def get_story(sid):
    for s in load_stories():
        if s.get("id", "").lower() == sid.lower():
            return s
    sys.exit(f"keel: story '{sid}' not found in {STORIES.name}")


def story_map():
    return {s.get("id"): s for s in load_stories() if isinstance(s, dict) and s.get("id")}


def unmet_depends_on(s, store=None):
    """Reasons this story's depends_on predecessors are not all status done."""
    store = store if store is not None else story_map()
    deps = s.get("depends_on")
    if deps is None:
        return []
    if not isinstance(deps, list):
        return ["depends_on is not an array of story ids"]
    reasons = []
    for did in deps:
        pred = store.get(did)
        if not pred:
            reasons.append(f"depends_on {did} is missing (need done)")
        elif pred.get("status") != "done":
            reasons.append(f"depends_on {did} is {pred.get('status')} (need done)")
    return reasons


def parse_state_fields(text):
    """Extract Phase / Resume cue / Last verified from existing STATE.md."""
    fields, current = {}, None
    for line in text.splitlines():
        m = re.match(r"^-\s+(Phase|Open intents|Active work|Resume cue|Last verified|Generated at):\s*(.*)$", line)
        if m:
            current = m.group(1).lower().replace(" ", "_")
            fields[current] = m.group(2).strip()
        elif current == "resume_cue" and line.startswith("  ") and line.strip():
            fields["resume_cue"] += " " + line.strip()
        elif line.startswith("- "):
            current = None
    return fields


# ---------------------------------------------------------------- gate
def gate_issues(s):
    issues = []
    note = lambda sev, msg: issues.append((sev, msg))
    for f in ("as_a", "i_want", "so_that"):
        if not str(s.get(f, "")).strip():
            note("BLOCKER", f"narrative incomplete: missing '{f}'")
    if not s.get("epic"):
        note("MAJOR", "no epic")
    if s.get("priority") not in ("p0", "p1", "p2"):
        note("MAJOR", f"priority must be p0|p1|p2, got '{s.get('priority')}'")
    acs = s.get("ac") or []
    dods = s.get("dod") or []
    if len(acs) < 1:
        note("BLOCKER", "needs at least one acceptance criterion")
    if len(dods) < 1:
        note("BLOCKER", "needs at least one DoD item")
    if len(acs) > 7:
        note("MINOR", f"{len(acs)} ACs — consider splitting the story")
    seen = set()
    for i, ac in enumerate(acs, 1):
        low = ac.lower()
        for w in VAGUE:
            if w in low:
                note("MAJOR", f"AC-{i} contains vague term '{w}': {ac[:70]}…")
        if len(ac) > 200:
            note("MINOR", f"AC-{i} is an essay ({len(ac)} chars) — split or tighten")
        if ac.lower() in seen:
            note("MAJOR", f"AC-{i} duplicates another criterion")
        seen.add(ac.lower())
    scope = s.get("scope")
    touch = forbid = []
    if isinstance(scope, dict):
        touch = scope.get("touch") or []
        forbid = scope.get("forbid") or []
    if s.get("status") in ("backlog", "ready"):
        if not isinstance(scope, dict) or (not touch and not forbid):
            note("MINOR", "scope unset — add touch/forbid path prefixes when the story edits files")
    deps = s.get("depends_on")
    if deps is not None:
        if not isinstance(deps, list):
            note("BLOCKER", "depends_on must be an array of story ids")
        else:
            ids = {x.get("id") for x in load_stories() if isinstance(x, dict)}
            for did in deps:
                if did not in ids:
                    note("BLOCKER", f"depends_on names an id not in the store: {did}")
    return issues


def cmd_gate(args):
    s = get_story(args.story_id)
    issues = gate_issues(s)
    if s["status"] == "done":
        print(f"NOTE  {s['id']} is already done — gate is informational.")
    blockers = sum(1 for sev, _ in issues if sev == "BLOCKER")
    majors = sum(1 for sev, _ in issues if sev == "MAJOR")
    verdict = "FAIL" if blockers else ("PASS WITH NOTES" if (majors or issues) else "PASS")
    print(f"GATE {s['id']} · {s['title'][:60]}")
    for sev, msg in issues:
        print(f"{sev:<7} {msg}")
    print(verdict)
    sys.exit(1 if blockers else 0)


# ---------------------------------------------------------------- claim
def cmd_claim(args):
    arr = load_stories()
    target = None
    for s in arr:
        if s.get("id", "").lower() == args.story_id.lower():
            target = s
            break
    if target is None:
        sys.exit(f"keel: story '{args.story_id}' not found in {STORIES.name}")
    if target["status"] != "ready":
        print(f"claim refused · {target['id']} status is {target['status']} (need ready)",
              file=sys.stderr)
        sys.exit(1)
    for reason in unmet_depends_on(target):
        print(f"claim refused · {target['id']} {reason}", file=sys.stderr)
        sys.exit(1)
    keys_before = set(target.keys())
    target["status"] = "in_progress"
    if set(target.keys()) != keys_before:
        sys.exit("keel: claim must not add story fields")
    save_stories(arr)
    root = git("rev-parse", "--show-toplevel")
    head = git("rev-parse", "--short", "HEAD")
    print(f"CLAIM {target['id']}")
    print(f"root {root}")
    print(f"HEAD {head}")


# ---------------------------------------------------------------- epic-gate / epic-claim
EPIC_REQUIRED = ("id", "title", "goal", "stories", "depends_on", "scope", "status")


def cmd_epic_gate(args):
    eid = args.epic_id
    obj, _path = load_epic(eid)
    issues = []
    note = lambda sev, msg: issues.append((sev, msg))
    for k in EPIC_REQUIRED:
        if k not in obj:
            note("BLOCKER", f"missing key '{k}'")
    if obj.get("id") != eid:
        note("BLOCKER", f"id '{obj.get('id')}' does not match filename {eid}")
    stories = obj.get("stories")
    if not isinstance(stories, list):
        note("BLOCKER", "stories must be an array")
        stories = []
    deps = obj.get("depends_on")
    if deps is not None and not isinstance(deps, list):
        note("BLOCKER", "depends_on must be an array")
        deps = []
    deps = deps or []
    scope = obj.get("scope") if isinstance(obj.get("scope"), dict) else {}
    touch = list(scope.get("touch") or [])
    store = {s.get("id"): s for s in load_stories() if isinstance(s, dict)}
    for sid in stories:
        st = store.get(sid)
        if st is None:
            note("BLOCKER", f"stories[] names missing id {sid}")
        elif st.get("epic") != eid:
            note("BLOCKER", f"{sid} story.epic is '{st.get('epic')}', expected {eid}")
    for did in deps:
        dpath = EPICS_DIR / f"{did}.json"
        if not dpath.exists():
            note("BLOCKER", f"depends_on epic {did} is missing")
            continue
        try:
            dobj = json.loads(dpath.read_text(encoding="utf-8"))
        except Exception:
            note("BLOCKER", f"depends_on epic {did} unparseable")
            continue
        if dobj.get("status") != "done":
            note("BLOCKER", f"depends_on epic {did} is not done")
    if obj.get("status") != "done":
        for p in list_epic_paths():
            other_id = p.stem
            if other_id == eid:
                continue
            try:
                other = json.loads(p.read_text(encoding="utf-8"))
            except Exception:
                continue
            if other.get("status") == "done":
                continue
            otouch = []
            if isinstance(other.get("scope"), dict):
                otouch = list(other["scope"].get("touch") or [])
            for a in touch:
                for b in otouch:
                    if prefix_overlap(a, b):
                        note("BLOCKER", f"scope.touch '{a}' overlaps {other_id} '{b}'")
    blockers = sum(1 for sev, _ in issues if sev == "BLOCKER")
    print(f"EPIC-GATE {eid} · {str(obj.get('title', ''))[:60]}")
    for sev, msg in issues:
        print(f"{sev:<7} {msg}")
    print("FAIL" if blockers else "PASS")
    sys.exit(1 if blockers else 0)


def cmd_epic_claim(args):
    eid = args.epic_id
    obj, path = load_epic(eid)
    if obj.get("status") != "ready":
        print(f"claim refused · {eid} status is {obj.get('status')} (need ready)",
              file=sys.stderr)
        sys.exit(1)
    for p in list_epic_paths():
        if p.stem == eid:
            continue
        try:
            other = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            continue
        if other.get("status") == "in_progress":
            print(f"claim refused · {other.get('id', p.stem)} is in_progress (WIP 1)",
                  file=sys.stderr)
            sys.exit(1)
    obj["status"] = "in_progress"
    save_epic(obj)
    print(f"CLAIM {eid}")


# ---------------------------------------------------------------- pack
def build_story_pack(s):
    laws = []
    if LAWS_DIR.exists():
        laws = sorted(p for p in LAWS_DIR.glob("*.md"))
    included, total = [], 0
    for p in laws:
        t = p.read_text(encoding="utf-8")
        if total + len(t) <= 4000:
            included.append((p.name, t)); total += len(t)
        else:
            included.append((p.name, f"[law too large to inline — read {p} on demand]"))
    dec_tail = re.findall(r"^## (D-\d+) · ([^\n]+)", DECISIONS.read_text(encoding="utf-8"))[:5] \
        if DECISIONS.exists() else []
    sf = parse_state_fields(STATE.read_text(encoding="utf-8")) if STATE.exists() else {}
    out = []
    out.append(f"# RUN PACK · {s['id']}")
    out.append(f"generated {NOW():%Y-%m-%d %H:%M}Z · HEAD {git('rev-parse', '--short', 'HEAD')}")
    out.append("")
    out.append("You are executing ONE story inside its scope. Obey every law below.")
    out.append("Do not claim done without reporting verification evidence for each AC and DoD.")
    out.append("Do not edit files outside your scope. Do not invent work beyond this pack.")
    out.append("")
    out.append("## Write-set")
    out.append("Paths are relative to this working-copy root.")
    out.append("You may write:")
    out.append("- src/")
    out.append("- archive/evidence/")
    out.append("- archive/packs/")
    out.append("This story's status may be set to in_progress or review.")
    out.append("Status done is forbidden.")
    out.append("Status blocked is operator-only.")
    out.append("")
    out.append("## Do-not-write")
    out.append("- METHOD.md")
    out.append("- bin/")
    out.append("")
    out.append("## Scope")
    scope = s.get("scope") if isinstance(s.get("scope"), dict) else None
    touch = list((scope or {}).get("touch") or [])
    forbid = list((scope or {}).get("forbid") or [])
    if not touch and not forbid:
        out.append("Scope: unset")
    else:
        for pfx in touch:
            out.append(f"- touch {pfx}")
        for pfx in forbid:
            out.append(f"- forbid {pfx}")
    out.append("")
    out.append(f"## Story {s['id']} · {s['title']}")
    out.append(f"- epic {s.get('epic')} · priority {s.get('priority')} · status {s['status']}")
    out.append(f"- As a {s.get('as_a')}, I want {s.get('i_want')} so that {s.get('so_that')}.")
    out.append("\n### Acceptance criteria (each needs evidence)")
    for i, ac in enumerate(s.get("ac") or [], 1):
        out.append(f"- [ ] AC-{i}: {ac}")
    out.append("\n### Definition of Done")
    for i, d in enumerate(s.get("dod") or [], 1):
        out.append(f"- [ ] DoD-{i}: {d}")
    if included:
        out.append("\n## Laws")
        for name, body in included:
            out.append(f"\n### law/{name}\n{body}")
    if dec_tail:
        out.append("\n## Recent decisions (context)")
        for did, title in dec_tail:
            out.append(f"- {did}: {title}")
    cue = sf.get("resume_cue", "")
    if cue:
        out.append(f"\n## Resume context\n{cue}")
    return "\n".join(out) + "\n"


def cmd_pack(args):
    s = get_story(args.story_id)
    for reason in unmet_depends_on(s):
        print(f"pack refused · {s['id']} {reason}", file=sys.stderr)
        sys.exit(1)
    text = build_story_pack(s)
    if args.save:
        ARCHIVE.mkdir(exist_ok=True)
        pdir = ARCHIVE / "packs"; pdir.mkdir(exist_ok=True)
        fname = pdir / f"{args.story_id}-{NOW():%Y%m%d-%H%M%S}.md"
        fname.write_text(text, encoding="utf-8")
        print(f"pack saved → {fname.relative_to(ROOT)} ({len(text)} bytes)")
    else:
        print(text, end="")


def story_is_unlocked(s, by_id):
    if s.get("status") != "ready":
        return False
    for did in s.get("depends_on") or []:
        pred = by_id.get(did)
        if not pred or pred.get("status") != "done":
            return False
    return True


def active_epic_ids():
    ids = []
    for p in list_epic_paths():
        try:
            o = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            continue
        if isinstance(o, dict) and o.get("status") in ("in_progress", "review"):
            ids.append(str(o.get("id") or p.stem))
    return ids


def cmd_epic_pack(args):
    obj, _path = load_epic(args.epic_id)
    store = {s.get("id"): s for s in load_stories() if isinstance(s, dict)}
    out = [f"# EPIC PACK · {obj.get('id')}", f"goal {obj.get('goal', '')}", "", "## Stories"]
    first = None
    for sid in obj.get("stories") or []:
        st = store.get(sid)
        status = st.get("status") if st else "missing"
        unlocked = "yes" if st and story_is_unlocked(st, store) else "no"
        out.append(f"- {sid} · {status} · unlocked {unlocked}")
        if first is None and st and story_is_unlocked(st, store):
            first = st
    text = "\n".join(out) + "\n"
    print(text, end="")
    if first:
        print(build_story_pack(first), end="")


def cmd_epic_present(args):
    obj, _path = load_epic(args.epic_id)
    obj["status"] = "review"
    save_epic(obj)
    print(f"PRESENT {obj['id']}")


def cmd_epic_accept(args):
    obj, _path = load_epic(args.epic_id)
    arr = load_stories()
    store = {s.get("id"): s for s in arr if isinstance(s, dict)}
    illegal = ("in_progress", "ready", "backlog", "blocked")
    for sid in obj.get("stories") or []:
        st = store.get(sid)
        status = st.get("status") if st else "missing"
        if status in illegal or status not in ("review", "done"):
            print(f"epic-accept refused · {sid} is {status}", file=sys.stderr)
            sys.exit(1)
    for sid in obj.get("stories") or []:
        st = store[sid]
        if st.get("status") == "review":
            st["status"] = "done"
    obj["status"] = "done"
    save_stories(arr)
    save_epic(obj)
    print(f"ACCEPT {obj['id']}")


def cmd_park(args):
    arr = load_stories()
    target = None
    for s in arr:
        if s.get("id", "").lower() == args.story_id.lower():
            target = s
            break
    if target is None:
        sys.exit(f"keel: story '{args.story_id}' not found in {STORIES.name}")
    target["status"] = "blocked"
    save_stories(arr)
    print(f"PARK {target['id']}")


def cmd_reassign(args):
    dest = args.to
    arr = load_stories()
    target = None
    for s in arr:
        if s.get("id", "").lower() == args.story_id.lower():
            target = s
            break
    if target is None:
        sys.exit(f"keel: story '{args.story_id}' not found in {STORIES.name}")
    sid = target["id"]
    current = epic_listing(sid)
    if dest == "backlog":
        target["status"] = "backlog"
        if current:
            current["stories"] = [x for x in (current.get("stories") or []) if x != sid]
            save_epic(current)
    elif dest == "ready":
        target["status"] = "ready"
    else:
        dest_obj, _ = load_epic(dest)
        if current and current.get("id") != dest_obj.get("id"):
            current["stories"] = [x for x in (current.get("stories") or []) if x != sid]
            save_epic(current)
        stories = dest_obj.get("stories") or []
        if sid not in stories:
            stories.append(sid)
            dest_obj["stories"] = stories
        save_epic(dest_obj)
        target["epic"] = dest_obj["id"]
    save_stories(arr)
    print(f"REASSIGN {sid} → {dest}")


# ---------------------------------------------------------------- state
def cmd_state(args):
    stories = load_stories()
    by = {}
    for s in stories:
        by[s["status"]] = by.get(s["status"], 0) + 1
    ids_by = {}
    for s in stories:
        ids_by.setdefault(s["status"], []).append(s["id"])
    old = parse_state_fields(STATE.read_text(encoding="utf-8")) if STATE.exists() else {}
    phase = args.phase or old.get("phase", "unspecified")
    cue = args.cue or old.get("resume_cue", "-")
    verified = args.verified or old.get("last_verified", "never")
    ready = by.get("ready", 0)
    lines = [
        "# STATE",
        "",
        "Regenerated snapshot — bounded by design. History belongs to",
        "decisions.md and archive/, never here.",
        "",
        f"- Generated at: {NOW():%Y-%m-%d %H:%M}Z",
        f"- Phase: {phase}",
        f"- Open intents: {by.get('review', 0)} review · {by.get('blocked', 0)} blocked"
        + (f" ({', '.join(ids_by.get('review', []) + ids_by.get('blocked', []))})" if (ids_by.get('review') or ids_by.get('blocked')) else ""),
        f"- Active work: {by.get('in_progress', 0)}"
        + (f" ({', '.join(ids_by.get('in_progress', []))})" if ids_by.get('in_progress') else ""),
        f"- Active epics: {', '.join(active_epic_ids()) or 'none'}",
        f"- Ready to launch: {ready}" + (f" ({', '.join(ids_by['ready'])})" if ready else ""),
        f"- Backlog: {by.get('backlog', 0)} · Done: {by.get('done', 0)}",
        "",
        f"- Resume cue: {cue}",
        "",
        f"- Last verified: {verified}",
    ]
    STATE.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"state written · {len(chr(10).join(lines))} bytes · phase='{phase}'")


# ---------------------------------------------------------------- distill
def cmd_distill(args):
    if not ARCHIVE.exists() or not list(ARCHIVE.glob("log-*.md")):
        print("distill: no archive/log-*.md yet — nothing to distill. Raw history first, wisdom later.")
        return
    known = set(re.findall(r"^## (D-\d+)", DECISIONS.read_text(encoding="utf-8"))) if DECISIONS.exists() else set()
    cands = []
    for log in sorted(ARCHIVE.glob("log-*.md")):
        for m in re.finditer(r"^#{2,3}\s+(?!D-\d+)(.+)$", log.read_text(encoding="utf-8"), re.M):
            cands.append((log.name, m.group(1).strip()))
    new = [(l, t) for l, t in cands if not any(k in t for k in known)]
    print(f"distill: {len(new)} candidate headings not obviously present in decisions.md:")
    for log, title in new[:20]:
        print(f"  [{log}] {title}")
    print("Review manually; write durable ones into decisions.md yourself.")


# ---------------------------------------------------------------- render
CSS = """body{font-family:-apple-system,'Segoe UI',Roboto,sans-serif;margin:0;background:#f7f7f5;color:#1a1a1a}
main{max-width:880px;margin:0 auto;padding:24px 16px 64px}
h1{font-size:22px;margin:0 0 4px} .sub{color:#666;font-size:13px;margin-bottom:20px}
h2{font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:#888;margin:28px 0 8px;border-bottom:1px solid #ddd;padding-bottom:4px}
table{width:100%;border-collapse:collapse;font-size:14px;background:#fff;border:1px solid #ddd}
td,th{text-align:left;padding:6px 10px;border-bottom:1px solid #eee} th{background:#fafafa;font-weight:600;font-size:12px}
.id{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;color:#0a58ca}
.badge{display:inline-block;font-size:11px;padding:1px 7px;border-radius:9px;border:1px solid #ccc;color:#555}
.review,.blocked{background:#fff3e0;border-color:#e6a23c}.in_progress{background:#e8f0fe;border-color:#5b8def}
.ready{background:#e6f4ea;border-color:#34a853}.done{background:#f1f1f1;color:#999}
details{margin:4px 0} summary{cursor:pointer;font-size:14px;padding:6px 10px;background:#fff;border:1px solid #ddd}
ul{margin:6px 0} .cue{background:#fffbe6;border:1px solid #e6d24c;padding:10px 12px;font-size:14px}
.small{color:#999;font-size:12px;margin-top:32px;border-top:1px solid #ddd;padding-top:8px}
.gate{display:inline-block;font-size:11px;padding:1px 7px;border-radius:9px;border:1px solid #ccc}
.gate.pass{background:#e6f4ea;border-color:#34a853;color:#1e7e34}
.gate.issues{background:#fdecea;border-color:#d93025;color:#c5221f}
label.chk{display:block;font-size:13.5px;padding:2px 0;cursor:pointer}
.evq{background:#fafafa;border-left:3px solid #bbb;margin:6px 0;padding:4px 8px;font-size:12.5px;color:#444;white-space:pre-wrap}
.evq img{display:block;max-width:100%;margin-top:8px;border:1px solid #ddd}
.art a{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;color:#0a58ca;margin-right:12px}
ul.checks{list-style:none;padding-left:2px;font-size:13.5px}"""


def esc(t):
    return str(t).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def newest_artifact(kind, sid):
    d = ARCHIVE / kind
    hits = sorted(d.glob(f"{sid}-*.md")) if d.exists() else []
    return hits[-1] if hits else None


def newest_image(sid):
    d = ARCHIVE / "evidence"
    if not d.exists():
        return None
    hits = []
    for ext in ("png", "jpg", "jpeg", "webp"):
        hits.extend(d.glob(f"{sid}-*.{ext}"))
        hits.extend(d.glob(f"{sid}-*.{ext.upper()}"))
    hits = sorted(set(hits), key=lambda p: (p.stat().st_mtime, p.name))
    return hits[-1] if hits else None


def cmd_render(args):
    stories = load_stories()
    by, ids_by = {}, {}
    for s in stories:
        by[s["status"]] = by.get(s["status"], 0) + 1
        ids_by.setdefault(s["status"], []).append(s)
    sf = parse_state_fields(STATE.read_text(encoding="utf-8")) if STATE.exists() else {}
    head = git("rev-parse", "--short", "HEAD")
    h = [f"<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'>",
         f"<title>keel overview</title><style>{CSS}</style></head><body><main>",
         f"<h1>Project overview</h1>",
         f"<div class='sub'>phase: {sf.get('phase','?')} · generated {NOW():%Y-%m-%d %H:%M}Z · HEAD {head}"
         f" · <span class='badge'>generated by bin/render — never hand-edit</span></div>"]
    needs = ids_by.get("review", []) + ids_by.get("blocked", [])
    h.append("<h2>Needs you</h2>")
    if needs:
        h.append("<table><tr><th>ID</th><th>Status</th><th>Story</th><th>Prio</th></tr>")
        for s in needs:
            h.append(f"<tr><td class='id'>{s['id']}</td><td><span class='badge {s['status']}'>{s['status']}</span></td>"
                     f"<td>{esc(s['title'])}</td><td>{s.get('priority','')}</td></tr>")
        h.append("</table>")
        for s in needs:
            ev = newest_artifact("evidence", s["id"])
            img = newest_image(s["id"])
            if not ev and not img:
                continue
            block = [f"<div class='evq'><b>{s['id']} evidence:</b>"]
            if ev:
                rel = ev.relative_to(ROOT).as_posix()
                head3 = esc("\n".join(ev.read_text(encoding="utf-8").splitlines()[:3]))
                block.append(f" <a href='{rel}'>{rel}</a>\n{head3}")
            if img:
                rel = img.relative_to(ROOT).as_posix()
                block.append(f"<img src='{esc(rel)}' alt='{esc(s['id'])} evidence'>")
            block.append("</div>")
            h.append("".join(block))
    else:
        h.append("<div class='sub'>nothing waiting on human judgment ✓</div>")
    h.append("<h2>Progress</h2><table><tr><th>backlog</th><th>ready</th><th>in progress</th><th>review</th><th>blocked</th><th>done</th></tr><tr>")
    for k in ["backlog", "ready", "in_progress", "review", "blocked", "done"]:
        h.append(f"<td>{by.get(k, 0)}</td>")
    h.append("</tr></table>")
    inflight = ids_by.get("in_progress", [])
    h.append("<h2>In flight</h2>")
    h.append("<table><tr><th>ID</th><th>Story</th></tr>" +
             "".join(f"<tr><td class='id'>{s['id']}</td><td>{s['title']}</td></tr>" for s in inflight) +
             "</table>" if inflight else "<div class='sub'>idle</div>")
    h.append("<h2>All stories</h2>")
    for s in stories:
        checks = "".join(
            f"<li class='checks'><label class='chk'><input type='checkbox'> {esc(a)}</label></li>"
            for a in s.get("ac", []))
        dod = "".join(
            f"<li class='checks'><label class='chk'><input type='checkbox'> {esc(d)}</label></li>"
            for d in s.get("dod", []))
        chip = ""
        if s["status"] == "backlog":
            n = len(gate_issues(s))
            chip = ("<span class='gate pass'>gate PASS</span>" if n == 0
                    else f"<span class='gate issues'>gate {n} issues</span>")
        arts = []
        for p in (newest_artifact("packs", s["id"]), newest_artifact("evidence", s["id"])):
            if p:
                r = p.relative_to(ROOT).as_posix()
                arts.append(f"<a href='{r}'>{r}</a>")
        artlinks = f"<div class='art'>{''.join(arts)}</div>" if arts else ""
        h.append(f"<details><summary><span class='id'>{s['id']}</span> · {esc(s['title'])} "
                 f"<span class='badge {s['status']}'>{s['status']}</span> {chip}</summary>"
                 f"<div style='padding:8px 12px;background:#fff;border:1px solid #ddd;border-top:0'>"
                 f"<p><b>As a</b> {esc(s.get('as_a',''))} <b>I want</b> {esc(s.get('i_want',''))} <b>so that</b> {esc(s.get('so_that',''))}.</p>"
                 f"{artlinks}<b>AC</b><ul>{checks}</ul><b>DoD</b><ul>{dod}</ul></div></details>")
    if DECISIONS.exists():
        decs = re.findall(r"^## (D-\d+) · (\S+) · (.+)$", DECISIONS.read_text(encoding="utf-8"), re.M)[:6]
        h.append("<h2>Recent decisions</h2><ul>")
        for did, date, title in decs:
            h.append(f"<li><span class='id'>{did}</span> · {date} · {title}</li>")
        h.append("</ul>")
    h.append(f"<h2>Resume cue</h2><div class='cue'>{sf.get('resume_cue','-')}</div>")
    h.append(f"<div class='small'>canonical sources: data/stories.json · decisions.md · laws/ — this page is a projection.</div>")
    h.append("</main></body></html>")
    out = ROOT / "overview.html"
    out.write_text("\n".join(h), encoding="utf-8")
    print(f"rendered {out.relative_to(ROOT)} ({out.stat().st_size} bytes)")


# ---------------------------------------------------------------- adapt
BANNER = "<!-- AUTO-GENERATED by bin/adapt from METHOD.md — do not hand-edit. -->"


def build_adapter_files():
    core = _core_text()
    return {
        "AGENTS.md": f"{BANNER}\n{core}\nFull manual: METHOD.md. Toolchain in bin/ (stdlib Python).\n",
        ".hermes.md": f"{BANNER}\n{core}\nFull manual: METHOD.md. Toolchain in bin/ (stdlib Python).\n",
        "adapters/owui-system-prompt.md": f"<!-- AUTO-GENERATED system-prompt snippet for Open WebUI sessions bound to this repo -->\n{core}"
        "\nYou have Open Terminal access: run `bin/*` commands directly; keep STATE.md updated at session end.\n",
    }


def _core_text():
    return """# Entry point

You are working inside a **keel** method repository. Before ANY work:

1. `git pull --ff-only` (fresh environment: clone first; pull fails → stop and report).
2. Read `STATE.md` completely.
3. Read METHOD.md §1 invariants; repo wins over anything you were told elsewhere.
4. Task routing: given a story ID → load it + referenced laws only. Given an epic ID → P-EPIC-RUN (this epic only). No task → report
   phase / open intents / resume cue / ready count, then wait. Never invent work.
5. Emit: `BOOT ok · <phase> · <n ready> · epics <ids or none> · <resume cue>` before doing anything.

Forbidden until the BOOT line: editing files, running mutations, committing,
branching, installing, "improving" docs.

Invariants (full list in METHOD.md §1): everything that matters lives in this repo ·
STATE stays bounded · no done without evidence mapped to AC/DoD · one canonical store,
pages are projections · raw history archived, lessons distilled · IDs immutable ·
adapters are generated · complexity pays rent.

Reporting law: any "done" claim must cite evidence (commit hash or artifact path).
Unevidenced reports are void. Session end = P-END protocol in METHOD.md §3.

The agent must not run park, reassign, or epic-accept.
"""


def cmd_adapt(args):
    files = build_adapter_files()
    for name, content in files.items():
        p = ROOT / name
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content, encoding="utf-8")
        print(f"adapted → {p.relative_to(ROOT)} ({p.stat().st_size} bytes)")


# ---------------------------------------------------------------- verify
def cmd_verify(args):
    fails = warns = 0

    def line(status, msg):
        nonlocal fails, warns
        if status == "FAIL": fails += 1
        elif status == "WARN": warns += 1
        print(f"{status:<5} {msg}")

    try:
        arr = json.loads(STORIES.read_text(encoding="utf-8"))
        ok = isinstance(arr, list)
        line("PASS" if ok else "FAIL", "stories.json parses as array")
    except Exception as e:
        line("FAIL", f"stories.json unparseable: {e}"); arr = []

    ids = [s.get("id") for s in arr if isinstance(s, dict)]
    dupes = sorted({i for i in ids if ids.count(i) > 1})
    line("PASS" if not dupes else "FAIL", "story IDs unique" + (f" — duplicates: {dupes}" if dupes else ""))

    epic_ids = []
    for p in list_epic_paths():
        try:
            o = json.loads(p.read_text(encoding="utf-8"))
        except Exception as e:
            line("FAIL", f"epic {p.name} unparseable: {e}")
            continue
        eid = o.get("id") if isinstance(o, dict) else None
        if not eid:
            line("FAIL", f"epic {p.name} missing id")
            continue
        epic_ids.append(eid)
    edup = sorted({i for i in epic_ids if epic_ids.count(i) > 1})
    if list_epic_paths() or epic_ids:
        line("PASS" if not edup else "FAIL", "epic IDs unique" + (f" — duplicates: {edup}" if edup else ""))
    elif EPICS_DIR.exists():
        line("PASS", "epic IDs unique")

    bad = []
    if DECISIONS.exists():
        for n, l in enumerate(DECISIONS.read_text(encoding="utf-8").splitlines(), 1):
            if l.startswith("## ") and not re.match(r"^## D-\d+ · \d{4}-\d{2}-\d{2} · .+$", l):
                bad.append(n)
        line("PASS" if not bad else "FAIL", "decisions.md D-nn headings well-formed"
             + (f" — malformed lines: {bad}" if bad else ""))
    else:
        line("FAIL", "decisions.md missing")

    expected = build_adapter_files()
    stale = [n for n, c in expected.items()
             if not (ROOT / n).exists() or (ROOT / n).read_text(encoding="utf-8") != c]
    if stale:
        line("FAIL", f"adapters out of sync — run bin/adapt ({', '.join(stale)})")
    else:
        line("PASS", "adapters match regeneration")

    ov = ROOT / "overview.html"
    srcs = [p for d in (ROOT / "data", ROOT / "laws") for p in d.rglob("*") if p.is_file()]
    newest = max((p.stat().st_mtime for p in srcs), default=0)
    if not ov.exists():
        line("WARN", "overview.html missing — run bin/render")
    elif ov.stat().st_mtime < newest - 1:
        line("WARN", "overview.html older than store — run bin/render")
    else:
        line("PASS", "overview.html up to date")

    vf = ROOT / "VERSION"
    ver = None
    if not vf.exists():
        line("FAIL", "VERSION file missing")
    else:
        vlines = vf.read_text(encoding="utf-8").splitlines()
        if len(vlines) != 1 or not re.fullmatch(r"\d+\.\d+\.\d+", vlines[0].strip()):
            line("FAIL", "VERSION must be one line matching N.N.N")
        else:
            ver = vlines[0].strip()
            line("PASS", f"VERSION is {ver}")

    method_path = ROOT / "METHOD.md"
    status_line = None
    if method_path.exists():
        status_line = next((l for l in method_path.read_text(encoding="utf-8").splitlines()
                            if l.startswith("Status:")), None)
    if ver is None:
        line("FAIL", "METHOD Status line not checked (no VERSION)")
    elif not status_line:
        line("FAIL", "METHOD.md has no Status line")
    elif ver not in status_line:
        line("FAIL", f"METHOD.md Status line does not contain VERSION {ver}")
    else:
        line("PASS", "METHOD.md Status line contains VERSION")

    boot = subprocess.run([sys.executable, str(ROOT / "bin" / "keel"), "boot"],
                          capture_output=True, text=True)
    needle = f"keel v{ver}" if ver else None
    if ver is None:
        line("FAIL", "boot version not checked (no VERSION)")
    elif needle not in (boot.stdout or ""):
        line("FAIL", f"bin/boot stdout missing '{needle}'")
    else:
        line("PASS", "bin/boot stdout contains keel v + VERSION")

    print(f"VERIFY {'FAIL' if fails else ('WARN' if warns else 'PASS')} · {fails} fail · {warns} warn")
    sys.exit(1 if fails else 0)


# ---------------------------------------------------------------- init
TEMPLATE_PLAN = """# PLAN

Project milestones and phase gates live here.
Add phases as they emerge; keep this file bounded — state belongs in STATE.md,
history in decisions.md.
"""

TEMPLATE_README = """# <project name>

A keel workspace: contracts in `data/stories.json`, standing constraints in
`laws/`, decision residue in `decisions.md`, live status in `STATE.md`,
human overview generated to `overview.html`. Project code lives in `src/`.

## Loop

1. Session start \u2014 any agent harness reads the root `AGENTS.md` / `.hermes.md`
   (Open WebUI: paste `adapters/owui-system-prompt.md`). Agent emits
   `BOOT ok \u00b7 <phase> \u00b7 <n ready> \u00b7 <cue>` before touching anything.
2. Intent \u2192 contract \u2014 `skills/story-workshop/SKILL.md`: five question rounds,
   draft story, `bin/gate US-xx`, human signs (`sign US-xx`).
3. Execute \u2014 `bin/pack US-xx`; work inside scope; verify every AC and DoD.
4. Acceptance \u2014 evidence into `archive/evidence/`, story to review;
   the human judges (see `overview.html`) and commits `accept US-xx`.
5. Session end \u2014 `bin/state`, residue to `decisions.md`, commit + push.

Local-only by default; add a private GitHub/GitLab origin when you need sync.
Rules of the road: agents never accept their own work; only logged failures
(FAILURES.md) may change the method; complexity must pay rent.
"""


def cmd_init(args):
    import shutil
    stories = load_stories()
    if not (ROOT / ".git").exists():
        subprocess.run(["git", "init", "-b", "main", str(ROOT)], check=True,
                       capture_output=True)
        print("git repository created on branch main \u2014 local-only mode")
    if not args.force and not stories:
        sys.exit("init: this workspace already looks initialized (stories.json is empty). Use --force to re-init.")
    STORIES.write_text("[]\n", encoding="utf-8")
    wipe_epic_files()
    DECISIONS.write_text(
        "# DECISIONS\n\nNewest first. Format: `## D-nn \u00b7 YYYY-MM-DD \u00b7 title` followed by\n"
        "Rationale / Consequences / Refs. Corrections via supersede, never edits.\n",
        encoding="utf-8")
    for name in ("FAILURES.md", "AMENDMENTS.md"):
        path = ROOT / name
        t = path.read_text(encoding="utf-8")
        cut = t.index("\n## Ledger")
        path.write_text(t[:cut] + "\n## Ledger\n\n(none yet)\n", encoding="utf-8")
    for child in ARCHIVE.iterdir():
        if child.name == ".gitkeep":
            continue
        if child.is_dir():
            for g in child.iterdir():
                if g.is_file():
                    g.unlink()
                else:
                    shutil.rmtree(g)
        else:
            child.unlink()
    ov = ROOT / "overview.html"
    if ov.exists():
        ov.unlink()
    src = ROOT / "src"
    src.mkdir(exist_ok=True)
    (src / ".gitkeep").touch()
    cmd_state(argparse.Namespace(phase="P0 \u2014 project start",
                                 cue="Capture your first intent via skills/story-workshop: five question rounds, draft story, bin/gate, operator sign.",
                                 verified="never"))
    plan = ROOT / "PLAN.md"
    plan.write_text(TEMPLATE_PLAN, encoding="utf-8")
    (ROOT / "README.md").write_text(TEMPLATE_README, encoding="utf-8")
    bad = []
    pat = re.compile(r"\b(?:US|D|F|A)-\d+\b")
    for pth in sorted(ROOT.rglob("*")):
        if ".git" in pth.parts or pth.is_dir() or pth.suffix.lower() not in (
                ".md", ".json", ".txt", ".py", ".html", ".css", ".js"):
            continue
        try:
            txt = pth.read_text(encoding="utf-8")
        except Exception:
            continue
        for m in pat.finditer(txt):
            bad.append(f"{pth.relative_to(ROOT)}: {m.group(0)}")
    if bad:
        sys.exit("init: purity check FAILED \u2014 keel build identifiers remain:\n  "
                 + "\n  ".join(bad) + "\nFix TEMPLATE_ constants upstream, then re-run.")
    print("init complete:")
    print("  - stories.json emptied, decisions/ledgers reset (rules kept)")
    print("  - archive cleared, overview.html removed (run bin/render when ready)")
    print("  - src/ created for project code")
    print("  - STATE.md regenerated for P0")
    print("Review the diff, then make your first commit (e.g. 'init workspace').")


# ---------------------------------------------------------------- boot
def cmd_boot(args):
    stories = load_stories()
    ready = sum(1 for s in stories if s["status"] == "ready")
    sf = parse_state_fields(STATE.read_text(encoding="utf-8")) if STATE.exists() else {}
    ver = (ROOT / "VERSION").read_text(encoding="utf-8").strip() if (ROOT / "VERSION").exists() else "dev"
    print(f"BOOT ok · keel v{ver} · {sf.get('phase','?')} · {ready} ready · epics {', '.join(active_epic_ids()) or 'none'} · {sf.get('resume_cue','-')}")


# ---------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(prog="keel")
    sub = ap.add_subparsers(dest="cmd", required=True)
    g = sub.add_parser("gate"); g.add_argument("story_id"); g.set_defaults(fn=cmd_gate)
    c = sub.add_parser("claim"); c.add_argument("story_id"); c.set_defaults(fn=cmd_claim)
    eg = sub.add_parser("epic-gate"); eg.add_argument("epic_id"); eg.set_defaults(fn=cmd_epic_gate)
    ec = sub.add_parser("epic-claim"); ec.add_argument("epic_id"); ec.set_defaults(fn=cmd_epic_claim)
    epk = sub.add_parser("epic-pack"); epk.add_argument("epic_id"); epk.set_defaults(fn=cmd_epic_pack)
    epr = sub.add_parser("epic-present"); epr.add_argument("epic_id"); epr.set_defaults(fn=cmd_epic_present)
    ea = sub.add_parser("epic-accept"); ea.add_argument("epic_id"); ea.set_defaults(fn=cmd_epic_accept)
    pk = sub.add_parser("park"); pk.add_argument("story_id"); pk.set_defaults(fn=cmd_park)
    rs = sub.add_parser("reassign"); rs.add_argument("story_id"); rs.add_argument("--to", required=True); rs.set_defaults(fn=cmd_reassign)
    p = sub.add_parser("pack"); p.add_argument("story_id"); p.add_argument("--save", action="store_true"); p.set_defaults(fn=cmd_pack)
    s = sub.add_parser("state"); s.add_argument("--phase"); s.add_argument("--cue"); s.add_argument("--verified"); s.set_defaults(fn=cmd_state)
    sub.add_parser("distill").set_defaults(fn=cmd_distill)
    sub.add_parser("render").set_defaults(fn=cmd_render)
    sub.add_parser("adapt").set_defaults(fn=cmd_adapt)
    sub.add_parser("verify").set_defaults(fn=cmd_verify)
    i = sub.add_parser("init"); i.add_argument("--force", action="store_true"); i.set_defaults(fn=cmd_init)
    sub.add_parser("boot").set_defaults(fn=cmd_boot)
    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
